# Default site origin used for canonical URLs, Open Graph tags, and JSON-LD
# schema (see src/components/SEO.jsx and index.html's %VITE_SITE_ORIGIN%
# placeholders). This is the GitHub Pages domain. Vercel deploys of this same
# repo should override this with that deployment's own domain by setting
# VITE_SITE_ORIGIN in the Vercel project's Environment Variables -- do NOT
# edit it here for that, since this file is the shared GitHub Pages default.
VITE_SITE_ORIGIN=https://etorgroups.github.io
